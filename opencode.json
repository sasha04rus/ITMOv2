{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": [
    "practices/practice_04/AGENTS.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        }
      }
    }
  },
  "mcp": {
    "validate-subscriber-name": {
      "type": "local",
      "command": [
        "python3",
        "practices/practice_04/.opencode/mcp/validate_subscriber_name/server.py"
      ],
      "enabled": true,
      "environment": {}
    }
  },
  "plugin": [
    ".opencode/plugins/auto-runner-plugin.js"
  ]
}
